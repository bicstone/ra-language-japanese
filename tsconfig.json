{
	"compilerOptions": {
		"target": "es2015",
		"module": "preserve",
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"newLine": "lf"
	}
}
