{
	"baseBranches": ["main", "next"],
	"extends": ["github>bicstone/renovate-config"],
	"packageRules": [
		{
			"groupName": "main dependencies",
			"matchBaseBranches": ["main"],
			"matchDepTypes": ["dependencies"],
			"rangeStrategy": "update-lockfile",
			"schedule": ["before 6am"],
			"minimumReleaseAge": "0 seconds"
		},
		{
			"groupName": "main devDependencies",
			"matchBaseBranches": ["main"],
			"matchDepTypes": ["devDependencies"],
			"rangeStrategy": "pin",
			"schedule": ["before 6am on Saturday"]
		},
		{
			"followTag": "next",
			"groupName": "next dependencies",
			"ignoreUnstable": false,
			"matchBaseBranches": ["next"],
			"matchDepTypes": ["dependencies"],
			"rangeStrategy": "update-lockfile",
			"schedule": ["before 6am"],
			"minimumReleaseAge": "0 seconds"
		},
		{
			"groupName": "next devDependencies",
			"matchBaseBranches": ["next"],
			"matchDepTypes": ["devDependencies"],
			"rangeStrategy": "pin",
			"schedule": ["before 6am on Saturday"]
		},
		{
			"description": "Disable major updates because zshy, which is used to build this package, does not support the TypeScript 7 compiler API. Remove this rule once https://github.com/colinhacks/zshy/issues/48 is resolved",
			"matchPackageNames": ["typescript"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		}
	]
}
